# Local: copy to .env and start Uvicorn with --env-file .env.
# Render: set these as secret environment variables in the dashboard.
ATSC_ENV=development
ATSC_SESSION_SECRET=
ATSC_ASSISTANT_PASSWORD=
ATSC_AI_ENABLED=false
# Copy the complete chat-completions URL and exact model ID from your university provider.
# Never use a browser chat-page URL here. No endpoint/model is invented by this project.
ATSC_AI_CHAT_URL=
ATSC_AI_API_KEY=
ATSC_AI_MODEL=
ATSC_AI_PROVIDER_LABEL=University AI
ATSC_AI_REQUESTS_PER_HOUR=30
